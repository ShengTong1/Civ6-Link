{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "civlink-gui",
  "version": "0.1.0",
  "identifier": "io.github.shengtong.civlink",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CivLink 联机助手",
        "width": 860,
        "height": 640,
        "resizable": true,
        "center": true,
        "dataDirectory": "userdata"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  }
}